# ==============================================================================
# UniServe Environment Variables Template
# ==============================================================================

# Option A: Full Supabase Database URL (Transaction Pooler or Direct Connection)
# Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Option B: Individual Connection Parameters
DB_TYPE=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASS=your_supabase_password

# Port configured automatically on Render (defaults to 10000 or 80)
PORT=10000
